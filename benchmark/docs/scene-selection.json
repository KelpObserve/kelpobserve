  "amendment": {
    "id": "glint-window-and-screen",
    "approved_on": "2026-09-20",
    "deviation_from": "sentinel2.window_days = 4, and processing every candidate in rank order.",
    "changes": {
      "sentinel2.window_days": 7,
      "sentinel2.screen_glint_max": 0.02
    },
    "rationale": "Under the registered four-day window every Sentinel-2 candidate failed the approved checks on sun glint: both orbits covering Sesimbra view close to the specular direction in summer. Scenes are selected on image quality, never on cover-prediction error, so widening the window and pre-screening glint does not select for a result. June remains unavailable on any date.",
    "evidence": "glint-screen.json",
    "primary_result_retained": "The four-day outcome stays in the record: June, July and September Sentinel-2 all unavailable. Every result computed under this amendment is labelled with it.",
    "screen_definition": "Median Sentinel-2 L2A reflectance at 1610 nm over the quadrat area plus 250 m. Calibrated against ACOLITE rhos at 1614 nm on four processed scenes, where ACOLITE reads 0.69 to 0.85 of the screen value, so the 0.02 screen limit sits safely above the 0.01 ACOLITE limit.",
    "screened_out_handling": "Recorded with their screen value and never silently dropped. A screened-out candidate counts as a determined failure in the ranking, not as unprocessed.",
    "unscreened_handling": "A candidate with no L2A product in the screen source cannot be screened, so it is processed in full rather than excluded. The screen only ever removes candidates it has measured."
  },
  "checks": {
    "status": "approved",
    "approved_on": "2026-09-19",
    "note": "Approved and registered before any per-scene quality metric was computed.",
