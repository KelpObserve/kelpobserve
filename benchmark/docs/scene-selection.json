    "definitions": {
      "completion": "ACOLITE wrote blue, green and red rhos.",
      "water": "Habitat-AOI pixels with lidar or DTM depth, resampled by nearest neighbour to the scene grid. Scene-independent.",
      "valid_water": "Water pixels with finite blue, green and red rhos, and rhot at ACOLITE's l2w_mask_wave not above l2w_mask_threshold, both read from the pinned ACOLITE sensor defaults.",
      "quadrat_cells": "Distinct native pixels containing the campaign's quadrats; the fraction that is valid water.",
      "glint": "Sentinel-2 only: median rhos at 1614 nm over water pixels with finite rhos, before the cloud mask.",
      "nir_residual": "Median rhos at NIR over valid water and over quadrat cells. Reported, never a pass/fail criterion.",
      "ranking": "Among passing Sentinel-2 scenes: sentinel2.ranking, with valid-water fraction as the third key. A group of tied scenes is decided only once every member is processed."
    }
