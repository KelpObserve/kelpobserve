{
  "registration": {
    "question": "Could this pipeline detect a realistically sized cover signal if one were present?",
    "base": "July QC-consistent PNeo units and the real 8 July V0 reflectance, depth and masks.",
    "synthetic_target": "Within-stratum permutation of the observed July cover over quadrats, one permutation per draw, so the real reflectance acts as noise with respect to the target and the depth-cover structure is kept.",
    "signal": "rhos change = pi * (Rrs(rho_mix, z) - Rrs(rho_background, z)) from oceanstream.coastal.inversion.lee.forward_model, rho_mix = c rho_kelp + (1 - c) rho_background, at 486/563/655 nm, solar zenith 20.83 deg, z = lidar depth at the pixel plus the acquisition water level.",
    "endmembers": "E5s taxon-balanced Pleiades Neo medians: kelp; background understory (mean of turf, coralline crust and red foliose: realistic for Sesimbra) or bare (rock and sand: optimistic bound).",
    "water": "E5s Sesimbra forced-560 QAA IOPs: the median (registered E5s value) and 2026-02-22 (the more attenuating date). Summer water was likely less clear (sonde chlorophyll), so both are optimistic.",
    "field": "Each quadrat paints a disc of radius 2.5 m (half the quadrat spacing) with its synthetic cover at its true position; other pixels take the synthetic stratum mean of the nearest quadrat.",
    "positional_error": "True positions = recorded positions plus one offset per transect, magnitude d in {0, 5, 10, 20} m, uniform random direction per draw.",
    "pipeline": "Inject into the real rasters, extract at the recorded positions with the Q3 QC rules, run the v1 July leave-one-transect-out on both scales.",
    "draws": 100,
    "null": "The same draws with zero signal give the rate at which spectral_depth_ridge beats depth_ridge by chance.",
    "recovered": "spectral_depth_ridge MAE at least 2 pp below depth_ridge MAE in >= 80% of draws.",
    "interpretation": {
      "understory_recovered_at_d_le_10": "The v1 negative result carries information about cover at this site.",
      "only_bare_recovered": "The v1 negative result is what the physics predicts for kelp over understory and says little about the sensor.",
      "nothing_recovered_at_d_0": "The design cannot detect even an optimistic signal; v1's negative result is inconclusive.",
      "recovery_lost_with_d": "Positional error alone could explain the v1 result at the offsets where recovery is lost."
    }
  },
