{
  "registration": {
    "question": "What can fixed campaign schedules support at this site?",
    "method": "oceanstream.coastal.acquire.usability.screen_usability over the v1 screen rectangle, with the water geometry from lidar or DTM, default UsabilityThresholds (glint angle >= 20 deg, water B11 <= 0.02, red haze, tile cloud <= 60%).",
    "pre_run_clarification": "Added 2026-10-02 before any window was screened, from geometry alone: screen_usability reads at 4x decimation (80 m for B11), which leaves fewer than the library's 200 water pixels in the 620 m rectangle, so every scene would read no_water. r1 calls the same steps as usability.assess (overpasses, item_tile_angles, measure_over_water, classify) with decimate=1. The library's winter figures for Sesimbra (25-33 usable dates per October-April season) were screened over the whole 36 x 45 km site, not the quadrat area, so they are not comparable with these counts.",
    "years": "2017-2026",
    "windows": {
      "june": "2 June +/- h",
      "july": "7 July - h to 8 July + h",
      "september": "1 September - h to 2 September + h",
      "h_days": [
        3,
        7,
        14
      ]
    },
    "tiers": {
      "usable": "Library verdict usable.",
      "likely_pass": "Usable and water B11 <= 0.012, the screen value at which the v1 calibration (ACOLITE reads 0.69-0.85 of the screen) puts ACOLITE 1614 nm below its 0.01 limit."
    },
    "reported": "Per year, campaign and h: overpasses, usable, likely_pass, by orbit; the share of years with at least one likely_pass overpass. No ACOLITE run and no quadrat-cell check, so this bounds availability from above."
